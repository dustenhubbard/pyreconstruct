// The class site: pyreconstruct.org/class* runs this Worker, which checks the
// password and serves the MkDocs build in public/class/. Secrets
// STUDENT_PASSWORD and STAFF_PASSWORD are set with `wrangler secret put`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pyreconstruct-class",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "pyreconstruct.org/class*", "zone_name": "pyreconstruct.org" }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // The term students can open. Change it here when a new term starts.
  "vars": { "CURRENT_TERM": "2026-fall" }
}
