#!/usr/bin/env python
"""Convert XML series to jser."""

import sys
from pathlib import Path

usage = "Convert legacy Reconstruct XML series to PyReconstruct jser file through command line.\nusage: series-from-xml <xml series .ser file, or a folder holding exactly one> [<output jser filepath>]"

args = sys.argv

if len(args) < 2 or args[1] == "--help":

    print(usage)
    sys.exit()

_, xml, *jser = sys.argv
    
xml = Path(xml)

if xml.is_dir():

    # only visible .ser files: a hidden ".<name>" folder from an earlier
    # conversion can end in .ser too
    found = [
        f for f in xml.iterdir()
        if f.is_file() and f.suffix.lower() == ".ser" and not f.name.startswith(".")
    ]

    if len(found) != 1:

        print(f"Found {len(found)} .ser files in {xml}. Please provide the .ser file of the series to convert.")
        sys.exit(1)

    xml = found[0]

if not xml.is_file() or xml.suffix.lower() != ".ser" or not xml.stem or xml.name.startswith("."):

    print("Please provide a legacy xml series (.ser) file, or a folder that holds exactly one.")
    sys.exit(1)

if not jser:
    
    jser = xml.with_suffix(".jser")

    if jser.exists():

        print(f"{jser} already exists. Please give an output jser filepath.")
        sys.exit(1)

else:

    jser = Path(jser[0]).with_suffix(".jser")  # guarantee .jser as ext

from PyReconstruct.modules.backend.func import xmlToJSON
    
try:

    jser_series = xmlToJSON(str(xml))

except ValueError as e:

    print(e)
    sys.exit(1)

jser_series.saveJser(str(jser), close=True)

print(f"\nSeries output to: {jser.absolute()}")
